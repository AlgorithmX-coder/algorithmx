generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// LAYER 1 — ACCOUNT (NextAuth-compatible, product-neutral)
// ============================================================
// User = a single parent / family account. The Account, Session
// and VerificationToken tables match the standard NextAuth
// Prisma-adapter shape so an OAuth provider (Google etc.) can
// be wired in without another migration. Nothing in this layer
// references any product.

model User {
  id             String    @id @default(cuid())
  name           String?
  email          String    @unique
  emailVerified  DateTime?
  image          String?
  /// bcrypt hash for the credentials provider. Null for users
  /// who only signed in via OAuth.
  hashedPassword String?
  role           String    @default("learner")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  accounts            Account[]
  sessions            Session[]
  children            ChildProfile[]
  entitlements        Entitlement[]
  passwordResetTokens PasswordResetToken[]
  preferences         UserPreference?
  orgMemberships      OrgMember[]
  seats               Seat[]
  enrolments          Enrolment[]
  packShareLinks      PackShareLink[]
  classesTaught       Class[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId      String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  /// SHA-256 hex of the token — a leaked DB does not expose live tokens.
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

/// Per-account accessibility / comfort preferences. Lives on the
/// account, not on any product — same setting follows the family
/// across every track they're enrolled in.
model UserPreference {
  userId           String   @id
  comfortMode      Boolean  @default(false)
  narrationEnabled Boolean  @default(true)
  reducedMotion    Boolean  @default(false)
  updatedAt        DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ============================================================
// LAYER 2 — PRODUCT (the multi-track catalogue)
// ============================================================
// One row per purchasable/grantable learning track. Adding a
// new track is a Product row + content — no schema migration.

enum ProductStatus {
  ACTIVE
  COMING_SOON
}

model Product {
  id        String        @id @default(cuid())
  slug      String        @unique
  name      String
  ageMin    Int
  ageMax    Int
  /// Price stored in PENCE to avoid floating-point money bugs.
  /// 9900 = £99.00. UI is responsible for formatting to £xx.xx.
  priceGBP  Int
  weeks     Int
  status    ProductStatus @default(COMING_SOON)
  /// Catalog display metadata (lifted from old Course; only the four
  /// fields the dashboard actually read are surfaced — description and
  /// color were dead code).
  emoji      String
  ageRange   String
  duration   String
  /// Stored as a cache of `COUNT(CourseContent WHERE productId = id)`.
  /// Seeded from the real row count so the two can never disagree —
  /// content edits must update this in lock-step (see seed.ts pattern).
  weeksCount Int
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  entitlements   Entitlement[]
  progress       Progress[]
  waitlist       WaitlistEntry[]
  courseContents CourseContent[]
  enrolments     Enrolment[]
}

// ============================================================
// LAYER 2b — COURSE CONTENT (per-week lesson data, product-scoped)
// ============================================================
// Replaces the old Course/Module pair. Catalog metadata lives on
// Product; per-week lesson data lives here. One row per
// (product, week). Faithful port of the old Module: every field
// preserved, courseId → productId, weekNumber → week. Both `week`
// and `order` are kept since the brief said "do not drop or invent
// fields" — the seed has always set them equal but the schema
// preserves the distinction. `updatedAt` is the only intentional
// addition (post-launch content edits).

model CourseContent {
  id          String   @id @default(cuid())
  productId   String
  week        Int
  title       String
  description String
  order       Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  product  Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  progress Progress[]

  @@unique([productId, week])
  @@index([productId])
}

// ============================================================
// LAYER 3 — ENTITLEMENT (the access gate)
// ============================================================
// Does this family have access to this product? One row per
// (user, product). `source` records WHY the grant exists so
// bundle changes / manual overrides / chargebacks stay traceable.

enum EntitlementSource {
  MANUAL
  PURCHASE
  BUNDLE
}

model Entitlement {
  id        String            @id @default(cuid())
  userId    String
  productId String
  grantedAt DateTime          @default(now())
  source    EntitlementSource

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
  @@index([productId])
}

// ============================================================
// LAYER 4 — PROFILE (children hang off the family account)
// ============================================================
// A ChildProfile is product-neutral — the same kid plays every
// track the parent has bought. dateOfBirth is stored as the
// canonical age source; UI/derive-on-read computes the current
// integer age. Never store a stale integer.

model ChildProfile {
  id              String   @id @default(cuid())
  userId          String
  name            String
  /// Optional since the school spine: a school never hands us a child's
  /// birthday. A family profile still has one; a school pupil has a year
  /// group on their class instead, which is all the age signal we need.
  dateOfBirth     DateTime?
  favouriteColour String
  /// Set for a school pupil, null for a child on a family account. This one
  /// field is the whole difference between the two.
  classId         String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  class    Class?     @relation(fields: [classId], references: [id], onDelete: SetNull)
  progress Progress[]

  @@index([userId])
  @@index([classId])
}

// ============================================================
// LAYER 5 — PROGRESS (per child × product × week)
// ============================================================
// One row per (childProfile, product, week). `screen` is the
// furthest screen the child has reached this week; `stars` is
// the best stars earned (clamped 0–3 at the app layer). When
// `completedAt` is set, the week is finished. Idempotent
// writes via the composite unique index.

model Progress {
  id              String    @id @default(cuid())
  childProfileId  String
  productId       String
  /// FK to the specific CourseContent row this progress belongs to.
  /// Denormalised against (productId, week) — the API is responsible
  /// for ensuring they agree — but kept as a hard FK so dropping a
  /// week's content cascades to its progress rows and the
  /// `include: { courseContent: ... }` pattern works for dashboard reads.
  courseContentId String
  week            Int
  screen          Int
  stars           Int
  /// Best total XP the child earned on this week, max-merged on each
  /// write so a weaker replay can never lower it. Cumulative XP / rank
  /// is the sum of this across the child's weeks. Badges + stickers
  /// stay derived from `completedAt`; XP is a quantity, so it is the
  /// one reward that must be stored rather than derived.
  xp              Int       @default(0)
  completedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  childProfile  ChildProfile  @relation(fields: [childProfileId], references: [id], onDelete: Cascade)
  product       Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  courseContent CourseContent @relation(fields: [courseContentId], references: [id], onDelete: Cascade)

  @@unique([childProfileId, productId, week])
  @@index([childProfileId])
  @@index([productId])
  @@index([courseContentId])
}

// ============================================================
// SUPPORTING — WAITLIST
// ============================================================
// Parent expresses interest in a product before it launches.
// Was keyed off a free-text courseSlug; now FK'd to Product so
// "remind me when this is live" notifications stay consistent
// with the catalogue.

model WaitlistEntry {
  id        String   @id @default(cuid())
  email     String
  productId String
  source    String?
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([email, productId])
  @@index([productId])
}

// ---------------------------------------------------------------------------
// AI Cleared (corporate). Adult, module-based, seat-licensed by a firm.
// Deliberately separate from ChildProfile/Progress, which are child- and
// week-keyed. A learner is a User who claimed a Seat; the Entitlement to the
// `ai-cleared` Product is still granted through the normal funnel, so every
// gated route keeps using hasEntitlement().
// ---------------------------------------------------------------------------

enum OrgPlan {
  TEAM
  FIRM
  ENTERPRISE
}

enum OrgRole {
  ADMIN
  MANAGER
  LEARNER
}

/// The desk a learner sees. Same modules, different data pack, task,
/// situations and prove bank. GENERAL catches unmapped job titles.
enum ClearedTrack {
  FINANCE
  LEGAL
  HR
  SALES
  SUPPORT
  OPS
  IT
  LEADERSHIP
  GENERAL
}

enum ModulePhase {
  LEARN
  PRACTISE
  PROVE
  DONE
}

enum SandboxTool {
  COPILOT
  CHATGPT
  GEMINI
  CLAUDE
}

/// OK = cleared, WARN = over-shared (CONFIDENTIAL went out),
/// CRIT = leaked (RESTRICTED went out).
enum SandboxVerdict {
  OK
  WARN
  CRIT
}

/// The two corporate courses a seat can be for. Mirrors the Product slugs
/// ai-cleared and ai-fluent; a seat's course decides which product the
/// claim enrols the person on.
enum CourseKey {
  AI_CLEARED
  AI_FLUENT
}

/// AI Fluent's verdict on a practice: the loop was run well, one move was
/// missing, or the first answer was taken as the answer.
enum FluentVerdict {
  FLUENT
  NEARLY
  NOT_YET
}

model Organisation {
  id               String   @id @default(cuid())
  name             String
  slug             String   @unique
  sector           String?
  contactName      String?
  contactRole      String?
  seatsPurchased   Int      @default(0)
  /// AI Fluent seats, licensed separately from the Cleared seats above.
  fluentSeatsPurchased Int  @default(0)
  plan             OrgPlan  @default(TEAM)
  stripeCustomerId String?
  /// Set by the checkout webhook so a repeated delivery creates nothing twice.
  stripeCheckoutSessionId String? @unique
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  members      OrgMember[]
  seats        Seat[]
  profile      FirmProfile?
  school       SchoolProfile?
  classes      Class[]
  enrolments   Enrolment[]
  certificates Certificate[]
  packShares   PackShareLink[]
  purchases    SeatPurchase[]
}

/// One card purchase of seats: a new firm, or seats added to the firm the
/// buyer already runs. Keyed by the Stripe session so a repeated webhook
/// delivery adds nothing twice.
model SeatPurchase {
  id                      String    @id @default(cuid())
  orgId                   String
  course                  CourseKey
  seats                   Int
  stripeCheckoutSessionId String    @unique
  createdAt               DateTime  @default(now())

  org Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
}

model OrgMember {
  id        String   @id @default(cuid())
  orgId     String
  userId    String
  role      OrgRole  @default(LEARNER)
  team      String?
  createdAt DateTime @default(now())

  org  Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([orgId, userId])
  @@index([userId])
}

/// Reserved on invite, claimed on first sign-in via /ai-cleared/join/[token].
model Seat {
  id          String        @id @default(cuid())
  orgId       String
  email       String
  userId      String?
  inviteToken String        @unique
  team        String?
  trackHint   ClearedTrack?
  /// The role the seat grants on claim. An admin invite is a seat with ADMIN.
  role        OrgRole       @default(LEARNER)
  /// Which course the seat is for. A person can hold one seat per course.
  course      CourseKey     @default(AI_CLEARED)
  invitedAt   DateTime      @default(now())
  claimedAt   DateTime?

  org  Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([orgId, email, course])
  @@index([userId])
}

/// Read at render time by modules 2, 3 and 5. One per firm.
model FirmProfile {
  id                String   @id @default(cuid())
  orgId             String   @unique
  approvedTools     String[]
  askFirstTools     String[]
  bannedTools       String[]
  /// The firm's own names for the four classes, defaulting to ours.
  classPublic       String   @default("PUBLIC")
  classInternal     String   @default("INTERNAL")
  classConfidential String   @default("CONFIDENTIAL")
  classRestricted   String   @default("RESTRICTED")
  escalationContact String
  escalationRole    String?
  regulator         String?
  policyText        String?
  updatedAt         DateTime @updatedAt

  org Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)
}

/// One per learner per course. `track` picks the desk in every module.
model Enrolment {
  id             String        @id @default(cuid())
  userId         String
  productId      String
  orgId          String
  track          ClearedTrack  @default(GENERAL)
  trackChangedAt DateTime?
  startedAt      DateTime      @default(now())
  completedAt    DateTime?
  finalScore     Int?

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  org     Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)

  modules     ModuleProgress[]
  attempts    SandboxAttempt[]
  certificate Certificate?
  playbook    PlaybookEntry[]

  @@unique([userId, productId])
  @@index([orgId])
}

/// Written on every screen change. Scores max-merge so a replay never lowers them.
model ModuleProgress {
  id          String          @id @default(cuid())
  enrolmentId String
  module      Int
  phase       ModulePhase     @default(LEARN)
  screen      Int             @default(0)
  proveScore  Int?
  proveTotal  Int?
  bestVerdict SandboxVerdict?
  /// AI Fluent's best practice verdict for the module; null on Cleared.
  bestFluent  FluentVerdict?
  completedAt DateTime?
  updatedAt   DateTime        @updatedAt

  enrolment Enrolment @relation(fields: [enrolmentId], references: [id], onDelete: Cascade)

  @@unique([enrolmentId, module])
}

/// Scores only. Never the prompt, never the reply.
model SandboxAttempt {
  id                String         @id @default(cuid())
  enrolmentId       String
  module            Int
  tool              SandboxTool
  verdict           SandboxVerdict
  countPublic       Int            @default(0)
  countInternal     Int            @default(0)
  countConfidential Int            @default(0)
  countRestricted   Int            @default(0)
  halted            Boolean        @default(false)
  /// AI Fluent only: the rubric verdict and score (0 to 100) for the send.
  fluentVerdict     FluentVerdict?
  rubricScore       Int?
  at                DateTime       @default(now())

  enrolment Enrolment @relation(fields: [enrolmentId], references: [id], onDelete: Cascade)

  @@index([enrolmentId])
}

/// AI Fluent's playbook: the one place the platform keeps text a learner
/// wrote. Their own prompt from a practice, the tool it was written for,
/// one line on when to use it and the check that goes with it. Private to
/// the learner (the admin sees a count), deleted with the enrolment.
model PlaybookEntry {
  id          String      @id @default(cuid())
  enrolmentId String
  module      Int
  workflow    String
  tool        SandboxTool
  prompt      String
  whenToUse   String?
  check       String?
  createdAt   DateTime    @default(now())

  enrolment Enrolment @relation(fields: [enrolmentId], references: [id], onDelete: Cascade)

  @@index([enrolmentId])
}

model Certificate {
  id          String   @id @default(cuid())
  enrolmentId String   @unique
  orgId       String
  serial      String   @unique
  score       Int
  issuedAt    DateTime @default(now())
  expiresAt   DateTime

  enrolment Enrolment    @relation(fields: [enrolmentId], references: [id], onDelete: Cascade)
  org       Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
}

/// A read-only link to ONE week's teacher pack, so a school can be shown the
/// product before anybody has an account.
///
/// Same shape as PasswordResetToken and for the same reason: the random half
/// lives only in the URL and only its hash is stored, so a copy of this table
/// hands out no working links. Unlike a signed token it can be revoked, and
/// the open count is the useful part for whoever sent it: you can tell whether
/// the school actually looked.
model PackShareLink {
  id           String    @id @default(cuid())
  tokenHash    String    @unique
  week         Int
  /// Who it went to, in whatever words the sender used. Never shown publicly.
  label        String?
  orgId        String
  createdById  String
  expiresAt    DateTime
  revokedAt    DateTime?
  opens        Int       @default(0)
  lastOpenedAt DateTime?
  createdAt    DateTime  @default(now())

  org       Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)
  createdBy User         @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([createdById])
}

/// Marks an Organisation as a SCHOOL rather than a firm.
///
/// Its presence is the answer to the question app/lib/schoolAccess.ts could
/// not answer before: whether the organisation a teacher belongs to is a
/// school at all. Sector was never usable for that, because it is free text
/// somebody types at onboarding and a wording difference would lock a real
/// teacher out of a live lesson.
model SchoolProfile {
  id        String   @id @default(cuid())
  orgId     String   @unique
  /// Who a teacher passes a disclosure to, in this school's own words. There
  /// is no country-neutral job title for this, so the school supplies one.
  safeguardingContact String?
  /// This country's child line service number. We never guess it and never
  /// ship a table of them: a wrong number in a safeguarding lesson is worse
  /// than none. The school fills it in once and it prints on the pack.
  childLineNumber     String?
  updatedAt DateTime @updatedAt

  org Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)
}

/// One class of pupils, taught by one teacher.
model Class {
  id        String   @id @default(cuid())
  orgId     String
  /// The teacher who made it. Other staff at the school can see it; this is
  /// who it belongs to.
  teacherId String
  /// What the school calls it. "4B", "Year 5 Oak".
  name      String
  /// 3 to 6. The only age signal stored about a school pupil, and it lives on
  /// the class rather than on the child.
  yearGroup Int?
  /// Printed on the login cards and typed by a child. Unambiguous alphabet,
  /// no letters a seven year old confuses with digits.
  code      String   @unique
  /// Archived at the end of a year rather than deleted, so last year's
  /// progress is still attached to something.
  archivedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org     Organisation   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  teacher User           @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  pupils  ChildProfile[]

  @@index([orgId])
  @@index([teacherId])
}
