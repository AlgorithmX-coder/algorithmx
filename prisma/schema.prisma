generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String    @id @default(cuid())
  name           String?
  email          String    @unique
  hashedPassword String?
  role           String    @default("learner")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}