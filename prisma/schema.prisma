generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
}

enum ProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

model User {
  id             String     @id @default(cuid())
  name           String?
  email          String     @unique
  hashedPassword String?
  role           String     @default("learner")
  // Stripe — one-time £99 lifetime purchase.  When stripeStatus is
  // 'active' or 'paid', the user has full access to /lesson/*.  All
  // other states (null, 'pending', 'cancelled', 'refunded') gate access.
  stripeCustomerId String?  @unique
  stripeStatus     String?
  stripePaidAt     DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  progress       Progress[]
  children       ChildProfile[]
}

model ChildProfile {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  childName   String
  age         Int
  avatarColor String   @default("purple")
  createdAt   DateTime @default(now())
}

model Course {
  id          String   @id @default(cuid())
  title       String
  description String
  ageRange    String
  duration    String
  weeksCount  Int
  emoji       String
  color       String
  createdAt   DateTime @default(now())
  modules     Module[]
}

model Module {
  id          String     @id @default(cuid())
  courseId    String
  course      Course     @relation(fields: [courseId], references: [id])
  weekNumber  Int
  title       String
  description String
  order       Int
  createdAt   DateTime   @default(now())
  progress    Progress[]
}

model Progress {
  id          String         @id @default(cuid())
  userId      String
  user        User           @relation(fields: [userId], references: [id])
  moduleId    String
  module      Module         @relation(fields: [moduleId], references: [id])
  status      ProgressStatus @default(NOT_STARTED)
  completedAt DateTime?
  createdAt   DateTime       @default(now())

  @@unique([userId, moduleId])
}

model WaitlistEntry {
  id         String   @id @default(cuid())
  email      String
  courseSlug String
  source     String?
  createdAt  DateTime @default(now())

  @@unique([email, courseSlug])
  @@index([courseSlug])
}
